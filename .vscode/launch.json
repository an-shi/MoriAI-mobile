{
  // 使用 VS Code 的 Dart / Flutter 扩展进行调试。
  // F5 默认使用第一个配置（当前选中的 Android 真机或模拟器）。
  // 需要网页调试时，在“运行和调试”面板选择 Mori (Chrome)。
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mori (Android 真机/模拟器)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "Mori (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "chrome"]
    },
    {
      "name": "Mori (使用当前设备)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--debug"]
    }
  ]
}
